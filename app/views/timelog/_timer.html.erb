<% content_for :header_tags do %>
    <% lang = current_language.to_s %>
    <% if lang != 'en' && File.exist?(File.join(Redmine::Plugin.find(:timelog_timer).directory, 'assets', 'javascripts', 'i18n', "#{lang}.js")) %>
        <%= javascript_include_tag "i18n/#{lang}.js", :plugin => "timelog_timer" %>
    <% end %>
<%= javascript_include_tag "store.js", "timer.js", :plugin => "timelog_timer" %>
<% end %>
